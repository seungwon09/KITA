NODE_ENV=development
PORT=3000
TRUST_PROXY=false
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PIN=replace-with-a-private-admin-pin
STRICT_PRODUCTION_SECURITY=false
ALLOW_DEV_PAYMENTS=true
ENFORCE_HTTPS=false

LOCAL_LLM_MODEL=qwen2.5:3b
AI_API_PROVIDER=openai-compatible
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_MODEL=gpt-4.1-mini
AI_API_KEY=
MONGO_URI=mongodb://mongo:27017/kita
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

PAYMENT_PROVIDER=toss
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
PUBLIC_BASE_URL=http://127.0.0.1:3000

KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://127.0.0.1:3000/api/auth/kakao/callback

# Firebase Auth / security bridge
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MEASUREMENT_ID=
