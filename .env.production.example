NODE_ENV=production
TRUST_PROXY=true
KITA_DOMAIN=kita.example.com
PUBLIC_BASE_URL=https://kita.example.com
CORS_ORIGINS=https://kita.example.com
STRICT_PRODUCTION_SECURITY=true
ALLOW_DEV_PAYMENTS=false
ENFORCE_HTTPS=true

# Replace both values before release.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PIN=replace-with-a-private-admin-pin
MONGO_USERNAME=kita_admin
MONGO_PASSWORD=replace-with-a-long-random-database-password

LOCAL_LLM_MODEL=qwen2.5:3b
AI_API_PROVIDER=openai-compatible
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_MODEL=gpt-4.1-mini
AI_API_KEY=
PAYMENT_PROVIDER=toss
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=https://kita.example.com/api/auth/kakao/callback
